# Porta HTTP deste backend.
PORT=3000

# API Python de OCR/parsing (serviço externo, fora deste repo) — 2 endpoints:
# processar 1 imagem e processar um array de imagens. Ela mesma grava o
# resultado no banco dela; este backend só repassa o(s) arquivo(s).
PYTHON_API_URL=http://localhost:8000
PYTHON_PROCESS_IMAGE_PATH=/process-image
PYTHON_PROCESS_IMAGES_PATH=/process-images
PYTHON_API_TIMEOUT_MS=30000
