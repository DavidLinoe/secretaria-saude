{
  "name": "secretaria-saude-backend",
  "version": "0.1.0",
  "description": "Backend do MVP Secretaria da Saúde — ponte para a API Python de OCR/parsing + CRUD leve de histórico de notas.",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node -r dotenv/config src/main.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r dotenv/config dist/main.js",
    "verify": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "axios": "^1.9.0",
    "form-data": "^4.0.4",
    "multer": "^2.4.0",
    "pdfjs-dist": "^3.11.174",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.7",
    "pdfkit": "^0.20.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
